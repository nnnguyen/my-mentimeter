# Copy this file to .env and fill in real values. Never commit .env.

DATABASE_URL="postgresql://mentimeter:mentimeter@localhost:5433/mentimeter?schema=public"

PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# JWT used to sign the auth cookie (httpOnly)
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Google OAuth 2.0 credentials (see README for how to create these)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback
